<div class="op2e chat-teste {{#if passou}}sucesso{{else}}falha{{/if}}">
  {{#if flavor}}<h3>{{flavor}}</h3>{{/if}}

  <div class="op2e-dados">
    {{#each resultados as |r|}}
      <span class="op2e-dado {{#if r.anulado}}op2e-dado-anulado{{/if}}">d{{r.tamanho}}: <strong>{{r.valor}}</strong></span>
    {{/each}}
    {{#if pavor}}
      <span class="op2e-dado op2e-dado-pavor" title="{{localize 'OP2E.Pavor.Dica'}}"><i class="fa-solid fa-skull"></i> d{{pavor.tamanho}}: <strong>{{pavor.valor}}</strong></span>
    {{/if}}
  </div>

  <div class="op2e-resultado-linha">
    <span>{{localize "OP2E.Chat.Total"}}: <strong>{{total}}</strong></span>
    <span>{{localize "OP2E.Chat.DT"}}: {{dt}}</span>
  </div>

  <div class="op2e-resultado-linha">
    <span>RA: {{ra}}</span>
    <span>RB: {{rb}}</span>
  </div>

  <div class="op2e-veredito">
    {{#if falhaCritica}}
      {{localize "OP2E.Chat.FalhaCritica"}}
    {{else if critico}}
      {{localize "OP2E.Chat.SucessoCritico"}}
    {{else if passou}}
      {{localize "OP2E.Chat.Sucesso"}}
    {{else}}
      {{localize "OP2E.Chat.Falha"}}
    {{/if}}
  </div>

  {{#if efeitoFalhaCritica}}
    <div class="op2e-efeito-critico">
      <strong>{{localize "OP2E.Chat.EfeitoFalhaCritica"}} (1d8 = {{efeitoFalhaCritica.valor}}): {{efeitoFalhaCritica.nome}}.</strong>
      {{efeitoFalhaCritica.texto}}
    </div>
  {{/if}}

  {{#if extra}}<div class="op2e-extra">{{{extra}}}</div>{{/if}}
</div>
