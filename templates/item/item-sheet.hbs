<div class="op2e-ficha">
<header class="op2e-cabecalho">
  <img class="op2e-retrato" data-action="editImage" data-edit="img" src="{{item.img}}" alt="{{item.name}}">
  <div class="op2e-titulo">
    <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'OP2E.Nome'}}">
    <span class="op2e-tipo">{{localize (concat "TYPES.Item." item.type)}}</span>
  </div>
</header>

<div class="op2e-corpo">

  {{#if (eq item.type "habilidade")}}
    <label>{{localize "OP2E.Item.Origem"}}
      <select name="system.origem">
        <option value="perfil" {{#if (eq system.origem "perfil")}}selected{{/if}}>{{localize "OP2E.Perfil.Label"}}</option>
        <option value="ocupacao" {{#if (eq system.origem "ocupacao")}}selected{{/if}}>{{localize "OP2E.Ocupacao"}}</option>
        <option value="nivel" {{#if (eq system.origem "nivel")}}selected{{/if}}>{{localize "OP2E.Nivel"}}</option>
        <option value="outro" {{#if (eq system.origem "outro")}}selected{{/if}}>{{localize "OP2E.Outro"}}</option>
      </select>
    </label>
    <section class="op2e-editor">
      <h3>{{localize "OP2E.Descricao"}}</h3>
      {{editor system.descricao target="system.descricao" button=true editable=true engine="prosemirror"}}
    </section>
  {{/if}}

  {{#if (eq item.type "ferramenta")}}
    <label class="op2e-checkbox">
      <input type="checkbox" name="system.possuiCargas" {{#if system.possuiCargas}}checked{{/if}}>
      {{localize "OP2E.Item.PossuiCargas"}}
    </label>
    {{#if system.possuiCargas}}
    <div class="op2e-linha">
      <label>{{localize "OP2E.Item.Cargas"}}
        <input type="number" name="system.cargas.value" value="{{system.cargas.value}}" data-dtype="Number" min="0">
      </label>
      <span>/</span>
      <input type="number" name="system.cargas.max" value="{{system.cargas.max}}" data-dtype="Number" min="0">
    </div>
    {{/if}}
    <label>{{localize "OP2E.Item.ElementosDetectados"}}
      <input type="text" name="system.elementosDetectados" value="{{system.elementosDetectados}}">
    </label>
    <section class="op2e-editor">
      <h3>{{localize "OP2E.Descricao"}}</h3>
      {{editor system.descricao target="system.descricao" button=true editable=true engine="prosemirror"}}
    </section>
    <section class="op2e-editor">
      <h3>{{localize "OP2E.Item.Mecanica"}}</h3>
      {{editor system.mecanica target="system.mecanica" button=true editable=true engine="prosemirror"}}
    </section>
  {{/if}}

  {{#if (eq item.type "item")}}
    <div class="op2e-linha">
      <label>{{localize "OP2E.Item.Quantidade"}}
        <input type="number" name="system.quantidade" value="{{system.quantidade}}" data-dtype="Number" min="0">
      </label>
      <label>{{localize "OP2E.Item.Categoria.Label"}}
        <select name="system.categoria">
          <option value="comum" {{#if (eq system.categoria "comum")}}selected{{/if}}>{{localize "OP2E.Item.Categoria.comum"}}</option>
          <option value="arma" {{#if (eq system.categoria "arma")}}selected{{/if}}>{{localize "OP2E.Item.Categoria.arma"}}</option>
          <option value="armadura" {{#if (eq system.categoria "armadura")}}selected{{/if}}>{{localize "OP2E.Item.Categoria.armadura"}}</option>
          <option value="consumivel" {{#if (eq system.categoria "consumivel")}}selected{{/if}}>{{localize "OP2E.Item.Categoria.consumivel"}}</option>
        </select>
      </label>
    </div>
    {{#if (eq system.categoria "arma")}}
    <div class="op2e-linha">
      <label>{{localize "OP2E.Item.Alcance.Label"}}
        <select name="system.alcance">
          <option value="corpo" {{#if (eq system.alcance "corpo")}}selected{{/if}}>{{localize "OP2E.Item.Alcance.corpo"}}</option>
          <option value="distancia" {{#if (eq system.alcance "distancia")}}selected{{/if}}>{{localize "OP2E.Item.Alcance.distancia"}}</option>
        </select>
      </label>
      <label>{{localize "OP2E.Item.DanoMod"}}
        <input type="number" name="system.danoMod" value="{{system.danoMod}}" data-dtype="Number">
      </label>
      <label>{{localize "OP2E.Item.PassoAtaque"}}
        <input type="number" name="system.passoAtaque" value="{{system.passoAtaque}}" data-dtype="Number">
      </label>
      <label>{{localize "OP2E.Item.IgnoraRD"}}
        <input type="number" name="system.ignoraRD" value="{{system.ignoraRD}}" data-dtype="Number" min="0">
      </label>
      <label>{{localize "OP2E.Item.CriticoMin"}}
        <input type="number" name="system.criticoMin" value="{{system.criticoMin}}" data-dtype="Number" min="2" max="20">
      </label>
    </div>
    {{/if}}
    {{#if (eq system.categoria "armadura")}}
    <div class="op2e-linha">
      <label>{{localize "OP2E.Item.ArmaduraPontos"}}
        <input type="number" name="system.armaduraPontos" value="{{system.armaduraPontos}}" data-dtype="Number" min="0">
      </label>
      <label class="op2e-checkbox">
        <input type="checkbox" name="system.equipado" {{#if system.equipado}}checked{{/if}}>
        {{localize "OP2E.Item.Equipado"}}
      </label>
    </div>
    {{/if}}
    {{#if (or (eq system.categoria "arma") (eq system.categoria "armadura"))}}
    <label>{{localize "OP2E.Item.Restricao"}}
      <input type="text" name="system.restricao" value="{{system.restricao}}">
    </label>
    {{/if}}
    <section class="op2e-editor">
      <h3>{{localize "OP2E.Descricao"}}</h3>
      {{editor system.descricao target="system.descricao" button=true editable=true engine="prosemirror"}}
    </section>
    <section class="op2e-editor">
      <h3>{{localize "OP2E.Item.MecanicaItem"}}</h3>
      {{editor system.mecanica target="system.mecanica" button=true editable=true engine="prosemirror"}}
    </section>
  {{/if}}

</div>
</div>
